---
import { getLastCommitDate } from "../lib/site";

const year = new Date().getFullYear();
const updated = getLastCommitDate();
const updatedText = updated.toISOString().slice(0, 10);
---

<footer class="mt-auto border-t border-stone-200 bg-white">
  <div class="mx-auto flex max-w-5xl flex-wrap justify-between gap-2 px-4 py-6 text-sm text-stone-500">
    <p>© {year} Kamil Slaby. Warlords Universe.</p>
    <p>Last updated: <time datetime={updatedText}>{updatedText}</time></p>
  </div>
</footer>