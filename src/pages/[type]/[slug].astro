---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import { titleOf, typeLabels } from "../../lib/entry";
import { getBacklinks } from "../../lib/links";
import { tagUrl } from "../../lib/content";

export async function getStaticPaths() {
  // tutaj dodaje nowa katerogie
  const types = ["races", "factions", "locations", "general", "champions", "bestiary"] as const;
  const paths = [];
  for (const type of types) {
    const entries = await getCollection(type, ({ data }) => data.published);
    for (const entry of entries) {
      paths.push({ params: { type, slug: entry.id }, props: { entry } });
    }
  }
  return paths;
}

const { type } = Astro.params;
const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const title = titleOf(entry);
const label = typeLabels[type as string];
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const backlinks = await getBacklinks(entry);
---

<Base title={title} description={entry.data.summary}>
    <!-- tutaj dodany tag pagefind, tak by latwo mozna bylo znalexc wszystko co sie dzieje -->
  <main data-pagefind-body class="">
    <nav data-pagefind-ignore aria-label="Breadcrumb" class="mb-4 text-sm text-stone-500">
      <a href="/">Home</a>
      <span class="mx-1">/</span>
      <a href={`/${type}/`}>{label.plural}</a>
      <span class="mx-1">/</span>
      <span>{title}</span>
    </nav>

    <div class="mt-8 grid gap-16 md:grid-cols-[1fr_16rem]">
      <aside class="space-y-6 md:order-2">
        <div class="rounded border border-stone-200 bg-white p-4 text-sm">
          <p data-pagefind-filter="type" class="text-stone-500">{label.singular}</p>
          <p class="font-semibold">{title}</p>
          <p class="text-stone-500">{entry.data.summary}</p>

          {entry.data.image && (
            <Image
              src={entry.data.image}
              alt={entry.data.imageAlt ?? ""}
              width={400}
              class="my-3 w-full rounded"
            />
          )}

          <dl class="space-y-2">
            {entry.data.aliases.length > 0 && (
              <div>
                <dt class="font-semibold">Also known as</dt>
                <dd>{entry.data.aliases.join(", ")}</dd>
              </div>
            )}
            {entry.data.tags.length > 0 && (
              <div>
                <dt class="font-semibold">Tags</dt>
                <dd>
                  <ul class="mt-1 flex flex-wrap gap-1">
                    {entry.data.tags.map((tag) => (
                      <li><a href={tagUrl(tag)} class="block rounded bg-stone-100 px-2 py-0.5 no-underline hover:bg-stone-200">{tag}</a></li>
                    ))}
                  </ul>
                </dd>
              </div>
            )}
          </dl>
        </div>

        {toc.length > 0 && (
          <nav aria-label="Table of contents" class="text-sm">
            <p class="mb-2 font-semibold">Contents</p>
            <ul class="space-y-1">
              {toc.map((h) => (
                <li class={h.depth === 3 ? "ml-4" : ""}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </aside>

      <article class="prose prose-stone max-w-none md:order-1">
        <Content />
      </article>
    </div>

    <!-- backlinks -->
    {backlinks.length > 0 && (
    <section data-pagefind-ignore class="mt-12 border-t border-stone-200 pt-6">
        <h2 class="text-lg font-semibold">Pages that link here</h2>
        <ul class="mt-2 list-disc pl-5">
        {backlinks.map((b) => (
            <li><a href={b.url}>{b.title}</a></li>
        ))}
        </ul>
    </section>
    )}
    <!-- end of backlinks -->

  </main>
</Base>