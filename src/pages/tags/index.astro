---
import Base from "../../layouts/Base.astro";
import { getTags } from "../../lib/content";

const tags = await getTags();
---

<Base title="Tags">
  <main class="">
    <h1 class="text-3xl font-bold">Tags</h1>
    {tags.length === 0 ? (
      <p class="mt-6 text-stone-500">No tags yet.</p>
    ) : (
      <ul class="mt-6 flex flex-wrap gap-2">
        {tags.map((t) => (
          <li>
            <a href={`/tags/${t.slug}/`} class="block rounded bg-white px-3 py-1 ring-1 ring-stone-200 hover:ring-stone-400">
              {t.label} <span class="text-stone-500">({t.items.length})</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>
</Base>