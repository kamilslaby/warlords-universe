---
import Base from "../../layouts/Base.astro";
import EntryList from "../../components/EntryList.astro";
import { getTags } from "../../lib/content";

export async function getStaticPaths() {
  const tags = await getTags();
  return tags.map((t) => ({ params: { tag: t.slug }, props: { tag: t } }));
}

const { tag } = Astro.props;
---

<Base title={`Tag: ${tag.label}`}>
  <main class="mx-auto max-w-5xl px-4 py-8">
    <nav aria-label="Breadcrumb" class="mb-4 text-sm text-stone-500">
      <a href="/" class="hover:underline">Home</a>
      <span class="mx-1">/</span>
      <a href="/tags/" class="hover:underline">Tags</a>
      <span class="mx-1">/</span>
      <span>{tag.label}</span>
    </nav>
    <h1 class="text-3xl font-bold">Tag: {tag.label}</h1>
    <div class="mt-6">
      <EntryList items={tag.items} showType />
    </div>
  </main>
</Base>